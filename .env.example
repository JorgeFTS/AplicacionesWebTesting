# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.
MYSQL_DATABASE=chambapro
MYSQL_USER=chambapro
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Minimo 32 caracteres. Para generar uno:  openssl rand -base64 48
TOKEN_SECRET=
# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:4173
